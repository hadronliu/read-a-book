# 应用配置
ENV=development
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./book_reader.db

# JWT 配置
SECRET_KEY=your-super-secret-key-change-this-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 文件上传配置
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

# 日志配置
LOG_LEVEL=info